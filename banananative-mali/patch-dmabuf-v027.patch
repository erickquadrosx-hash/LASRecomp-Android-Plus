+// SCM_RIGHTS and test every candidate against the Vulkan-mapped allocation: never assume that
+// the first FD is the data plane (some Android gralloc handles have metadata FDs too).
+static int vka_ahb_fd(AHardwareBuffer *ahb, void *vkmap, size_t n) {
+    int pair[2]; if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, pair)) return -1;
+    int fd = -1;
+    if (!AHardwareBuffer_sendHandleToUnixSocket(ahb, pair[0])) {
+        char body[512], anc[CMSG_SPACE(sizeof(int) * 32)];
+        struct iovec io = {.iov_base = body, .iov_len = sizeof body};
